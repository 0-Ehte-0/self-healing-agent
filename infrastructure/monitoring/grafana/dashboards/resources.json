      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=~\"demo-api|demo-worker|control-plane\"}[1m]) * 100",
          "legendFormat": "{{job}} process CPU",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"self-healing-.*\"}[1m])) by (name) * 100",
          "legendFormat": "{{name}} container CPU",
          "refId": "B"
        }
      ],
      "title": "CPU Saturation & Utilization (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
