{
  "$defs": {
    "RemediationStepSchema": {
      "additionalProperties": false,
      "description": "Pydantic representation of an ordered remediation step in a plan.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "plan_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "action": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "action_schema_version": {
          "default": "1.0",
          "maxLength": 16,
          "title": "Action Schema Version",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "verification": {
          "additionalProperties": true,
          "title": "Verification",
          "type": "object"
        }
      },
      "required": [
        "resource_id",
        "position",
        "action"
      ],
      "title": "RemediationStepSchema",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "TargetBinding": {
      "additionalProperties": false,
      "description": "Immutable binding between a logical resource and an exact Docker container.",
      "properties": {
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "container_id": {
          "description": "Exact Docker container hex ID (12 to 64 hex characters)",
          "pattern": "^[a-fA-F0-9]{12,64}$",
          "title": "Container Id",
          "type": "string"
        },
        "service_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Service Name",
          "type": "string"
        },
        "binding_generation": {
          "default": 1,
          "minimum": 1,
          "title": "Binding Generation",
          "type": "integer"
        }
      },
      "required": [
        "resource_id",
        "container_id",
        "service_name"
      ],
      "title": "TargetBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pydantic representation of a complete, typed, versioned remediation plan.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "incident_id": {
      "format": "uuid",
      "title": "Incident Id",
      "type": "string"
    },
    "diagnosis_id": {
      "format": "uuid",
      "title": "Diagnosis Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel",
      "default": "LOW"
    },
    "target_binding": {
      "$ref": "#/$defs/TargetBinding"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/RemediationStepSchema"
      },
      "title": "Steps",
      "type": "array"
    },
    "verification_profile": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "m1_default_restart_profile",
      "title": "Verification Profile"
    },
    "content_hash": {
      "description": "SHA-256 digest of canonical plan contents",
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "approved": {
      "default": false,
      "title": "Approved",
      "type": "boolean"
    },
    "actor": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    }
  },
  "required": [
    "incident_id",
    "diagnosis_id",
    "target_binding",
    "content_hash",
    "actor"
  ],
  "title": "RemediationPlanSchema",
  "type": "object"
}
